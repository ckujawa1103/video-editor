{
  "name": "pocket-cut",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A tiny browser-based video editor that runs entirely on your device.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/vendor-ffmpeg.mjs && vite build",
    "preview": "vite preview --host",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2"
  }
}
